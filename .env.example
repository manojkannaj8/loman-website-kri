# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://buildstudio.ie

# Enquiry form email delivery (https://resend.com). Without RESEND_API_KEY the
# form logs enquiries in development and returns 503 in production.
RESEND_API_KEY=
ENQUIRY_TO=info@buildstudio.ie
ENQUIRY_FROM="Build Studio Website <website@buildstudio.ie>"
